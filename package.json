{
  "name": "bamboosato-apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate:content && astro build",
    "validate:links": "node scripts/validate-links.mjs",
    "verify": "npm run test && npm run check && npm run build && npm run validate:links",
    "verify:bases": "npm run validate:content && node scripts/verify-bases.mjs",
    "verify:markdown": "node scripts/verify-markdown.mjs",
    "verify:usage": "node scripts/verify-usage.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.5",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "cheerio": "^1.1.2",
    "typescript": "~5.9.3"
  }
}
