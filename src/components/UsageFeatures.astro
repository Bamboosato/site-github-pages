---
import type { AppData } from '../lib/schema';
import { usageFeatures, ui, type Locale } from '../i18n/ui';
interface Props { features: AppData['usageFeatures']; locale: Locale; }
const { features, locale } = Astro.props;
---
{features.length > 0 && <ul class="usage-features" aria-label={ui[locale].features}>
  {features.map((feature) => <li>{usageFeatures[feature][locale]}</li>)}
</ul>}
