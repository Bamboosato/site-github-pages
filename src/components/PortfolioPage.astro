---
import Layout from '../layouts/Layout.astro';
import AppCard from './AppCard.astro';
import UpdateList from './UpdateList.astro';
import { siteConfig } from '../config/site';
import { categories, ui, type Locale, type CategoryId } from '../i18n/ui';
import { getApps, getUpdates } from '../lib/content';
import { pagePath, withBase } from '../lib/paths';
interface Props { locale: Locale; view: 'home' | 'apps' | 'updates' | 'about'; category?: CategoryId; }
const { locale, view, category } = Astro.props;
const t = ui[locale];
const apps = await getApps(locale);
const updates = view === 'updates' ? await getUpdates(locale) : [];
const path = category ? `apps/category/${category}/` : view === 'home' ? '' : `${view}/`;
const link = (route = '') => withBase(pagePath(locale, route), import.meta.env.BASE_URL);
const title = category ? categories[category][locale] : view === 'home' ? siteConfig.name : t[view];
const descriptions = { home: t.homeDescription, apps: t.appsDescription, updates: t.updatesDescription, about: t.aboutDescription };
const categoryEntries = Object.entries(categories) as [CategoryId, typeof categories[CategoryId]][];
const presentCategories = categoryEntries.filter(([id]) => apps.some((app) => app.data.category === id));
const featured = apps.filter((app) => app.data.featured).slice(0, 3);
const visibleApps = category ? apps.filter((app) => app.data.category === category) : apps;
---
<Layout locale={locale} title={title} description={descriptions[view]} path={path}>
  {view === 'home' ? <>
    <section class="hero container">
      <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{t.heroEyebrow}</p><h1>{t.heroTitle.split('\n').map((line) => <span>{line}</span>)}</h1><p class="hero-description">{t.heroDescription}</p><div class="hero-actions"><a class="button" href={link('apps/')}>{t.browse}<span aria-hidden="true">→</span></a><a class="text-link" href={link('about/')}>{t.readAbout}</a></div></div>
      <div class="hero-art" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three"></span><span class="art-dot"></span><span class="art-coordinate">01 / IDEAS IN PROGRESS</span><span class="art-corner">+</span></div>
    </section>
    {apps.some((app) => app.data.sample) && <div class="container"><aside class="sample-notice"><span class="sample-badge">{t.sample}</span><p>{t.sampleNotice}</p></aside></div>}
    {featured.length > 0 && <section class="section container"><div class="section-heading"><div><p class="eyebrow">{t.selectedLabel}</p><h2>{t.featured}</h2><p>{t.featuredDescription}</p></div><a class="text-link" href={link('apps/')}>{t.allApps}<span aria-hidden="true">→</span></a></div><div class="app-grid">{featured.map((app) => <AppCard app={app} locale={locale} />)}</div></section>}
    <section class="section section-tinted"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t.progressLabel}</p><h2>{t.recent}</h2><p>{t.recentDescription}</p></div><a class="text-link" href={link('updates/')}>{t.allUpdates}<span aria-hidden="true">→</span></a></div><div class="app-grid">{apps.slice(0, 3).map((app) => <AppCard app={app} locale={locale} />)}</div>{apps.length === 0 && <p class="empty-state">{t.noApps}</p>}</div></section>
    <section class="section container"><div class="section-heading"><div><p class="eyebrow">{t.discoverLabel}</p><h2>{t.categories}</h2><p>{t.categoriesDescription}</p></div></div><div class="category-grid">{presentCategories.map(([id, labels], index) => <a class="category-tile" href={link(`apps/category/${id}/`)}><span class="category-number">0{index + 1}</span><span>{labels[locale]}</span><span aria-hidden="true">↗</span></a>)}</div></section>
    <section class="about-summary container"><p class="eyebrow">{t.makerLabel}</p><h2>{t.aboutHeading}</h2><p>{t.aboutBody}</p><a class="text-link" href={link('about/')}>{t.readAbout}<span aria-hidden="true">→</span></a></section>
  </> : <div class="container page-content">
    <div class="page-heading"><p class="eyebrow">{t.portfolio}</p><h1>{title}</h1><p>{descriptions[view]}</p></div>
    {view === 'apps' && <>
      {apps.some((app) => app.data.sample) && <aside class="sample-notice"><span class="sample-badge">{t.sample}</span><p>{t.sampleNotice}</p></aside>}
      <nav class="category-nav" aria-label={t.categories}><a href={link('apps/')} aria-current={!category ? 'page' : undefined}>{t.all}</a>{presentCategories.map(([id, labels]) => <a href={link(`apps/category/${id}/`)} aria-current={category === id ? 'page' : undefined}>{labels[locale]}</a>)}</nav>
      <section class="category-section"><div class="category-heading"><h2>{category ? categories[category][locale] : t.allApps}</h2><span>{visibleApps.length} {t.count}</span></div><div class="app-grid">{visibleApps.map((app) => <AppCard app={app} locale={locale} />)}</div></section>
      {visibleApps.length === 0 && <p class="empty-state">{t.noApps}</p>}
    </>}
    {view === 'updates' && <UpdateList updates={updates} apps={apps} locale={locale} />}
    {view === 'about' && <div class="about-content prose"><section><h2>{t.aboutHeading}</h2><p>{t.aboutBody}</p></section><section><h2>{t.aboutSite}</h2><p>{t.aboutSiteBody}</p></section><section><h2>{t.aboutLanguages}</h2><p>{t.aboutLanguagesBody}</p></section>{apps.some((app) => app.data.sample) && <aside class="sample-notice"><span class="sample-badge">{t.sample}</span><p>{t.sampleNotice}</p></aside>}<a class="button" href={siteConfig.githubUrl}>GitHub<span aria-hidden="true">↗</span></a></div>}
  </div>}
</Layout>
